# Telegram (https://my.telegram.org/apps para api_id/api_hash, @BotFather para el token)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Servicios debrid: configura al menos uno
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
TORBOX_API_KEY=
PREMIUMIZE_API_KEY=

# Opcional: IDs de Telegram autorizados, separados por comas. Vacío = cualquiera puede usar el bot
ALLOWED_USER_IDS=

# Opcional: carpeta temporal de descargas
DOWNLOAD_DIR=downloads

# Opcional: DEBUG para ver el detalle de filecrypt/navegador, WARNING para solo errores
LOG_LEVEL=INFO
