# Telegram (https://my.telegram.org/apps para api_id/api_hash, @BotFather para el token)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# Servicios debrid: configura al menos uno
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
TORBOX_API_KEY=
PREMIUMIZE_API_KEY=
DEBRIDLINK_API_KEY=
DEEPBRID_API_KEY=
# Mega-Debrid: API key de aplicación O login+password (la key tiene prioridad)
MEGADEBRID_API_KEY=
MEGADEBRID_LOGIN=
MEGADEBRID_PASSWORD=
# High-Way: usuario y contraseña de high-way.me
HIGHWAY_LOGIN=
HIGHWAY_PASSWORD=

# Opcional: IDs de Telegram autorizados, separados por comas. Vacío = cualquiera puede usar el bot
ALLOWED_USER_IDS=

# Opcional: carpeta temporal de descargas
DOWNLOAD_DIR=downloads

# Opcional: proxy SOLO para los servicios debrid (API + descargas), Telegram va directo.
# Útil en VPS: AllDebrid y otros bloquean IPs de datacenter. Ejemplo NordVPN:
# DEBRID_PROXY=socks5h://usuario_servicio:pass_servicio@amsterdam.nl.socks.nordhold.net:1080
# Formatos: socks5://, socks5h:// (DNS por el proxy), socks4://, http://
DEBRID_PROXY=

# Opcional: relay de enlaces. El bot te da URLs suyas (http://ip_del_bot:puerto/dl/...)
# y descarga él del debrid, así el debrid solo ve la IP del servidor (evita baneos
# por "descargas desde IPs distintas" al usar el bot en una VPS). Abre el puerto.
LINK_PROXY=false
LINK_PROXY_PORT=8845
# URL pública si usas dominio/reverse proxy; vacío = autodetectar http://IP:PUERTO
LINK_PROXY_URL=

# Opcional: forzar servicio por hoster, ej: rapidgator:torbox, 1fichier.com:alldebrid
# Servicios: realdebrid, alldebrid, torbox, premiumize, debridlink, megadebrid, deepbrid, highway
HOST_RULES=
# Si un servicio no desbloquea un enlace, probar automáticamente con el resto
FAILOVER=true

# Opcional: fallback con yt-dlp (YouTube, Vimeo, …) si el debrid y la descarga
# directa fallan. Requiere: pip install yt-dlp  (y ffmpeg para fusionar vídeo+audio)
YTDLP=false
# Selector de formato de yt-dlp (por defecto: mejor vídeo + mejor audio)
# YTDLP_FORMAT=bv*+ba/b
# Re-codificar a H.264+AAC tras descargar (QuickTime/Mac). Por defecto true.
# Si el archivo ya es H.264+AAC se omite. false = dejar codecs originales (VP9/AV1/Opus…).
# Requiere ffmpeg. Solo aplica a la opción 📤 Archivo (no al enlace directo).
YTDLP_REENCODE_H264=true

# Opcional: botón para subir el archivo a DripFiles (API free, sin key, caduca ~2 días).
# false = ocultar el botón. https://dripfiles.com/api/v1/free
DRIPFILES=true
# Mensaje/descripción del envío (campo message de Droppy). Placeholders: {filename} {host} {size}
# DRIPFILES_MESSAGE={filename}
# Host: {host}
# Tamaño: {size}

# Opcional: DEBUG para ver el detalle de filecrypt/navegador, WARNING para solo errores
LOG_LEVEL=INFO
